<?xml version="1.0" encoding="UTF-8"?>
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="hepingeast2.net.xml"/>
        <route-files value="real_traffic_hep.rou.xml"/>
        <additional-files value="scenarios/heping/rsu.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
    </time>
    <output>
        <tripinfo-output value="tripinfos_heping.xml"/>
        <statistic-output value="stats_heping.xml"/>
    </output>
    <processing>
        <ignore-route-errors value="false"/>
    </processing>
    <report>
        <verbose value="false"/>
        <duration-log.statistics value="true"/>
        <no-step-log value="true"/>
    </report>
</sumoConfiguration>
