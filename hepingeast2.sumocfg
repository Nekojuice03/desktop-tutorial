<?xml version="1.0" encoding="UTF-8"?>
<!--
  和平東路二段/復興南路場景(論文主場景)——「三件套對齊」的單一事實來源。

  倉庫裡的 osm.sumocfg 仍指向舊的忠孝東路小十字路網(osm.net.xml.gz +
  real_traffic.rou.xml),那是造成「場景錯配」的來源。正式實驗請一律用
  本檔,或在指令中明確指定本檔。

  注意:XML 註解內不可出現連續兩個減號,故本段一律以文字描述參數。

  route-files 由 make_real_flow.py 產生(未入庫,見 .gitignore):
      python make_real_flow.py 並指定 net 為 hepingeast2.net.xml
  additional 的 rsu.add.xml 由 setup_rsu.py 產生(junction 模式、每路口 2 角):
      python setup_rsu.py 並指定 net 為 hepingeast2.net.xml
-->
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="hepingeast2.net.xml"/>
        <route-files value="real_traffic_hep.rou.xml"/>
        <additional-files value="rsu.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
    </time>
    <processing>
        <ignore-route-errors value="true"/>
        <tls.actuated.jam-threshold value="30"/>
    </processing>
    <report>
        <no-step-log value="true"/>
        <duration-log.disable value="true"/>
    </report>
    <gui_only>
        <gui-settings-file value="osm.view.xml"/>
    </gui_only>
</sumoConfiguration>
